# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB. Replace with your own connection string; never commit real credentials.
MONGODB_URI=mongodb://localhost:27017/parallel_market_ai
MONGO_MAX_RETRIES=5
MONGO_RETRY_DELAY_MS=2000

# JWT authentication foundation. Use separate long random secrets locally.
JWT_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Uploads
UPLOAD_PATH=uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# Future Cloudinary integration (prepared, not wired up yet)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (15 minutes, 100 requests per IP by default)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
